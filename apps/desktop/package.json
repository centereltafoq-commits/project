{
  "name": "@edu-center/desktop",
  "version": "1.0.4",
  "private": true,
  "description": "Educational Center ERP Windows Desktop Application",
  "author": "EduCenter Team",
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.json && esbuild src/preload/index.ts --bundle --platform=node --format=iife --external:electron --outfile=dist/preload/index.js",
    "build": "npm run build:main",
    "dev": "npm run build:main && electron dist/main/index.js",
    "test": "vitest run",
    "stage": "node scripts/stage-desktop-runtime.mjs",
    "pack:win": "npm run stage && electron-builder --win --x64",
    "pack:portable": "npm run stage && electron-builder --win portable --x64",
    "prepare:postgres": "powershell -ExecutionPolicy Bypass -File scripts/prepare-portable-postgres.ps1"
  },
  "dependencies": {
    "@edu-center/shared": "*",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "0.19.12",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
